FUNCTION(EXPAND_NUM_MPI_PROCS NUM_MPI_PROCS_SPEC OUT_VAR)

  STRING(REPLACE "," ";" NUM_MPI_PROCS_SPECS "${NUM_MPI_PROCS_SPEC}")

  SET(NUM_MPI_PROCS_LIST)

  FOREACH(PROC_SPEC IN LISTS NUM_MPI_PROCS_SPECS)

    IF(PROC_SPEC MATCHES "^([0-9]+)-([0-9]+)$")

      SET(FIRST_PROC "${CMAKE_MATCH_1}")
      SET(LAST_PROC  "${CMAKE_MATCH_2}")

      IF(FIRST_PROC GREATER LAST_PROC)
        MESSAGE(FATAL_ERROR
          "Invalid NUM_MPI_PROCS range '${PROC_SPEC}'")
      ENDIF()

      FOREACH(PROC_COUNT RANGE ${FIRST_PROC} ${LAST_PROC})
        LIST(APPEND NUM_MPI_PROCS_LIST ${PROC_COUNT})
      ENDFOREACH()

    ELSEIF(PROC_SPEC MATCHES "^[0-9]+$")

      LIST(APPEND NUM_MPI_PROCS_LIST ${PROC_SPEC})

    ELSE()

      MESSAGE(FATAL_ERROR
        "Invalid NUM_MPI_PROCS value '${PROC_SPEC}'")

    ENDIF()

  ENDFOREACH()

  LIST(REMOVE_DUPLICATES NUM_MPI_PROCS_LIST)

  SET(${OUT_VAR} "${NUM_MPI_PROCS_LIST}" PARENT_SCOPE)

ENDFUNCTION()

# A python test passes when unittest prints OK, which ignores the exit status, so also fail on an abort after the
# tests ran (e.g. during interpreter teardown).
SET(PYTHON_TEST_FAIL_REGULAR_EXPRESSIONS "Process received signal" "Kokkos ERROR" "Signal: Aborted")

FUNCTION(PYTHON_ADD_TEST TEST_NAME)

  SET(OPTIONS)
  SET(ONE_VALUE_ARGS NUM_MPI_PROCS)
  SET(MULTI_VALUE_ARGS)

  CMAKE_PARSE_ARGUMENTS(
    PYTHON_ADD_TEST
    "${OPTIONS}"
    "${ONE_VALUE_ARGS}"
    "${MULTI_VALUE_ARGS}"
    ${ARGN}
    )

  IF(NOT PYTHON_ADD_TEST_NUM_MPI_PROCS)
    SET(PYTHON_ADD_TEST_NUM_MPI_PROCS "1")
  ENDIF()

  EXPAND_NUM_MPI_PROCS(
    "${PYTHON_ADD_TEST_NUM_MPI_PROCS}"
    NUM_MPI_PROCS_LIST
    )

  IF(TPL_ENABLE_MPI)

    FOREACH(NUM_PROCS IN LISTS NUM_MPI_PROCS_LIST)

      TRIBITS_ADD_TEST(
        ${Python3_EXECUTABLE}
        NOEXEPREFIX
        NOEXESUFFIX
        NAME PYTHON_${TEST_NAME}
        ARGS "-m unittest ${TEST_NAME}.py"
        NUM_MPI_PROCS ${NUM_PROCS}
        PASS_REGULAR_EXPRESSION "OK"
        FAIL_REGULAR_EXPRESSION ${PYTHON_TEST_FAIL_REGULAR_EXPRESSIONS}
        ${PYTHON_ADD_TEST_UNPARSED_ARGUMENTS}
        )

      tribits_set_tests_properties(Krino_PYTHON_${TEST_NAME}_MPI_${NUM_PROCS}
        PROPERTIES ENVIRONMENT "${PyKrino_PYTHONPATH}")

    ENDFOREACH()

  ELSE()

    TRIBITS_ADD_TEST(
      ${Python3_EXECUTABLE}
      NOEXEPREFIX
      NOEXESUFFIX
      NAME PYTHON_${TEST_NAME}
      ARGS "-m unittest ${TEST_NAME}.py"
      NUM_MPI_PROCS 1
      PASS_REGULAR_EXPRESSION "OK"
      FAIL_REGULAR_EXPRESSION ${PYTHON_TEST_FAIL_REGULAR_EXPRESSIONS}
      ${PYTHON_ADD_TEST_UNPARSED_ARGUMENTS}
      )

    tribits_set_tests_properties(Krino_PYTHON_${TEST_NAME}
      PROPERTIES ENVIRONMENT "${PyKrino_PYTHONPATH}")

  ENDIF()

ENDFUNCTION()

#ifndef PHALANX_CONFIG_HPP
#define PHALANX_CONFIG_HPP

#cmakedefine PHX_DEBUG

#cmakedefine PHX_TEUCHOS_TIME_MONITOR

#cmakedefine PHX_ALLOW_MULTIPLE_EVALUATORS_FOR_SAME_FIELD

#cmakedefine PHX_ETI

#cmakedefine PHX_ENABLE_DEVICE_DAG

#cmakedefine PHX_ENABLE_KOKKOS_AMT

#cmakedefine PHX_DEPRECATED_DEVICE_AS_EXECUTION_SPACE

#cmakedefine PHX_ENABLE_SHARED_SPACE

#cmakedefine PHX_MEMORY_SPACE_IS_NOT_EXECUTION_SPACE_MEMORY_SPACE

#include <Kokkos_Core.hpp>
namespace PHX {
  using DefaultExecutionSpace = @Phalanx_DEFAULT_EXECUTION_SPACE@;
  using DefaultMemorySpace = @PHX_DEFAULT_MEMORY_SPACE_CXX@;
  // The device type Phalanx' Kokkos::Views are allocated with.  Use
  // PHX::ExecutionSpace or PHX::MemorySpace when you want one of the two
  // spaces on its own; a Kokkos::Device provides only execution_space,
  // memory_space and device_type.
#if defined(PHX_DEPRECATED_DEVICE_AS_EXECUTION_SPACE)
  using Device = PHX::DefaultExecutionSpace;
#else
  using Device = Kokkos::Device<PHX::DefaultExecutionSpace,PHX::DefaultMemorySpace>;
#endif
  using index_size_type = @PHX_INDEX_SIZE_TYPE_CXX@;
  using index_t = index_size_type;
}

@PHALANX_DEPRECATED_DECLARATIONS@

#endif

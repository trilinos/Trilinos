# CUDA/GPU acceleration settings for Trilinos
# Used by config/cuda/trilinos-build.cmake

# Kokkos CUDA backend: enables CUDA execution space
SET_BOOL_CACHE_VAR(Kokkos_ENABLE_CUDA ON)
# Enable CUDA lambdas (required for device-side functors in Tpetra, MueLu, etc.)
SET_BOOL_CACHE_VAR(Kokkos_ENABLE_CUDA_LAMBDA ON)

# GPU Architecture:
# Other valid options: AMPERE80, ADA89, HOPPER90, VOLTA70, PASCAL60
# Example: SET_BOOL_CACHE_VAR(Kokkos_ARCH_AMPERE80 ON)
SET_BOOL_CACHE_VAR(Kokkos_ARCH_HOPPER90 ON)

# Uncomment for CUDA Unified Virtual Memory (managed memory)
# SET_BOOL_CACHE_VAR(Kokkos_ENABLE_CUDA_UVM ON)

SET_BOOL_CACHE_VAR(KokkosKernels_INST_MEMSPACE_CUDAUVMSPACE OFF)
SET_BOOL_CACHE_VAR(Tpetra_ALLOCATE_IN_SHARED_SPACE OFF)

SET_BOOL_CACHE_VAR(Sacado_ENABLE_HIERARCHICAL_DFAD ON)

SET_BOOL_CACHE_VAR(CMAKE_CXX_USE_RESPONSE_FILE_FOR_OBJECTS ON)

# CUDA TPLs: NVIDIA CUDA Libraries
SET_BOOL_CACHE_VAR(TPL_ENABLE_CUDA ON)
SET_BOOL_CACHE_VAR(TPL_ENABLE_CUBLAS ON)
SET_BOOL_CACHE_VAR(TPL_ENABLE_CUSOLVER ON)
SET_BOOL_CACHE_VAR(TPL_ENABLE_CUSPARSE ON)

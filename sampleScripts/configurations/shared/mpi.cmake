# MPI configuration for Trilinos

# Enable MPI (Message Passing Interface)
SET_BOOL_CACHE_VAR(TPL_ENABLE_MPI ON)

ASSERT_DEFINED(
  TPL_ENABLE_MPI
  MPI_USE_COMPILER_WRAPPERS
)

IF (TPL_ENABLE_MPI)
  IF (NOT MPI_USE_COMPILER_WRAPPERS)
    # Manual mode: extract flags from mpicxx/mpicc using --showme
    # Used when MPI compiler wrappers have issues or when using non-standard setups
    EXECUTE_PROCESS(COMMAND mpicxx --showme:compile OUTPUT_VARIABLE MPI_CXX_FLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)
    EXECUTE_PROCESS(COMMAND mpicc --showme:compile OUTPUT_VARIABLE MPI_C_FLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)
    EXECUTE_PROCESS(COMMAND mpicxx --showme:link OUTPUT_VARIABLE MPI_LINK_FLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)

    SET(CMAKE_CXX_FLAGS "${MPI_CXX_FLAGS} ${CMAKE_CXX_FLAGS}" CACHE STRING "CXX flags" FORCE)
    SET(CMAKE_C_FLAGS "${MPI_C_FLAGS} ${CMAKE_C_FLAGS}" CACHE STRING "C flags" FORCE)
    SET(CMAKE_EXE_LINKER_FLAGS "${MPI_LINK_FLAGS} ${CMAKE_EXE_LINKER_FLAGS}" CACHE STRING "EXE linker flags" FORCE)
    SET(CMAKE_SHARED_LINKER_FLAGS "${MPI_LINK_FLAGS} ${CMAKE_SHARED_LINKER_FLAGS}" CACHE STRING "shared linker flags" FORCE)

    MESSAGE("CMAKE_CXX_FLAGS: \"${CMAKE_CXX_FLAGS}\"")
    MESSAGE("CMAKE_C_FLAGS:   \"${CMAKE_C_FLAGS}\"")
    MESSAGE("CMAKE_EXE_LINKER_FLAGS:   \"${CMAKE_EXE_LINKER_FLAGS}\"")
    MESSAGE("CMAKE_SHARED_LINKER_FLAGS:   \"${CMAKE_SHARED_LINKER_FLAGS}\"")
  ENDIF()
ENDIF()
